<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Complément COM pour Microsoft Word (Windows).
    Cible .NET Framework 4.0 pour rester compatible avec le plus grand nombre de
    versions de Windows et d'Office. Aucune dépendance aux PIA Office : tout
    l'accès à Word est fait en liaison tardive (dynamic / IDispatch), ce qui
    permet de fonctionner avec n'importe quelle version de Word, 32 ou 64 bits.
  -->
  <PropertyGroup>
    <TargetFramework>net40</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>WordTableToExcel</AssemblyName>
    <RootNamespace>WordTableToExcel</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!--
      C# 5 : la syntaxe que comprend le compilateur fourni avec Windows (.NET Framework 4), utilisé par build.cmd
      sur les postes sans SDK. Toute syntaxe plus récente est refusée ici, dès la compilation.
    -->
    <LangVersion>5</LangVersion>
    <!-- Version et attributs d'assemblage : src/Version.cs et Properties/AssemblyInfo.cs (aussi compilés par build.cmd). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Nom fort : recommandé pour « regasm /codebase » et évite tout conflit avec une autre DLL du même nom. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>WordTableToExcel.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Version.cs" Link="Properties\Version.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AddIn\Ribbon.xml" LogicalName="WordTableToExcel.Ribbon.xml" />
  </ItemGroup>

</Project>
